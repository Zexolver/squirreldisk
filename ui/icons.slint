import { Palette } from "./globals.slint";

export component DiskGlyph inherits Rectangle {
    in property <bool> removable: false;
    width: 48px;
    height: 48px;

    Rectangle {
        x: 4px;
        y: 10px;
        width: parent.width - 8px;
        height: parent.height - 18px;
        border-radius: 8px;
        background: Palette.bg-panel-alt;
        border-width: 2px;
        border-color: Palette.border-subtle;
    }

    Rectangle {
        x: 12px;
        y: 18px;
        width: parent.width - 24px;
        height: 6px;
        border-radius: 3px;
        background: root.removable ? Palette.green : Palette.accent;
    }

    Rectangle {
        x: parent.width / 2 - 8px;
        y: parent.height - 10px;
        width: 16px;
        height: 4px;
        border-radius: 2px;
        background: Palette.border-subtle;
    }
}

export component FolderGlyph inherits Rectangle {
    width: 48px;
    height: 48px;

    Rectangle {
        x: 6px;
        y: 14px;
        width: 16px;
        height: 6px;
        border-radius: 2px;
        background: #d1a53a;
    }

    Rectangle {
        x: 6px;
        y: 18px;
        width: parent.width - 12px;
        height: parent.height - 28px;
        border-radius: 4px;
        background: #eab308;
    }
}

export component FileGlyph inherits Rectangle {
    width: 20px;
    height: 20px;

    Rectangle {
        x: 2px;
        y: 1px;
        width: parent.width - 4px;
        height: parent.height - 2px;
        border-radius: 2px;
        background: Palette.border-subtle;
        border-width: 1px;
        border-color: Palette.text-muted;
    }
}
